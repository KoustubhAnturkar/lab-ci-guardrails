#!/usr/bin/env bash

set -uo pipefail

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root" || exit 1

failures=0
control_path="src/lab01-unsafe-control.js"

if [[ -e "$control_path" ]]; then
  printf 'FAIL: %s already exists; remove it before running the checker.\n' "$control_path" >&2
  exit 1
fi

temporary_directory=$(mktemp -d)

cleanup() {
  rm -f -- "$control_path"
  rm -rf -- "$temporary_directory"
}
trap cleanup EXIT

record_failure() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

if ! npm test; then
  record_failure "npm test did not pass"
fi

if ! npm run lint; then
  record_failure "npm run lint did not pass"
fi

if ! node <<'JS'
const { parseConfig } = require("./src/config");

const parsed = parseConfig('{"enabled":true}');
if (parsed.enabled !== true) process.exit(1);

try {
  parseConfig("1+1");
} catch (error) {
  process.exit(error instanceof SyntaxError ? 0 : 1);
}
process.exit(1);
JS
then
  record_failure "parseConfig must parse JSON as data and reject JavaScript expressions"
fi

printf 'eval("1 + 1");\n' > "$control_path"
lint_report="$temporary_directory/lint-control.txt"
if npx eslint "$control_path" >"$lint_report" 2>&1; then
  record_failure "ESLint accepted the unsafe control"
elif ! grep -q 'no-eval' "$lint_report"; then
  record_failure "the unsafe control failed ESLint for an unexpected reason"
fi
rm -f -- "$control_path"

if ! python3 <<'PY'
from pathlib import Path
import re
import sys

import yaml


def has_command(script: str, command: str) -> bool:
    segments = re.split(r"\n|&&|;", script)
    return command in (segment.strip() for segment in segments)


workflow_paths = sorted(Path(".github/workflows").glob("*.y*ml"))
if not workflow_paths:
    print("No YAML workflow found under .github/workflows/", file=sys.stderr)
    raise SystemExit(1)

matching_job = False
for path in workflow_paths:
    try:
        workflow = yaml.load(path.read_text(encoding="utf-8"), Loader=yaml.BaseLoader)
    except (OSError, UnicodeError, yaml.YAMLError) as error:
        print(f"{path}: invalid YAML: {error}", file=sys.stderr)
        continue

    if not isinstance(workflow, dict):
        continue

    events = workflow.get("on")
    if isinstance(events, dict):
        event_names = set(events)
    elif isinstance(events, list):
        event_names = set(events)
    else:
        event_names = {events}
    if not {"push", "pull_request"} <= event_names:
        continue

    jobs = workflow.get("jobs", {})
    if not isinstance(jobs, dict):
        continue

    for job in jobs.values():
        if not isinstance(job, dict):
            continue
        runner = job.get("runs-on", "")
        if not isinstance(runner, str) or not re.fullmatch(
            r"ubuntu-(latest|[0-9]{2}\.[0-9]{2}(-arm)?)", runner
        ):
            continue

        steps = job.get("steps", [])
        if not isinstance(steps, list):
            continue
        job_skipped_or_ignored = (
            str(job.get("continue-on-error", "")).lower() == "true"
            or str(job.get("if", "")).strip().lower() in {"false", "${{ false }}"}
        )
        step_skipped_or_ignored = any(
            isinstance(step, dict)
            and (
                str(step.get("continue-on-error", "")).lower() == "true"
                or str(step.get("if", "")).strip().lower() in {"false", "${{ false }}"}
            )
            for step in steps
        )
        if job_skipped_or_ignored or step_skipped_or_ignored:
            continue
        uses = [step.get("uses", "") for step in steps if isinstance(step, dict)]
        scripts = "\n".join(
            step.get("run", "")
            for step in steps
            if isinstance(step, dict) and isinstance(step.get("run", ""), str)
        )
        setup_steps = [
            step
            for step in steps
            if isinstance(step, dict) and step.get("uses", "").startswith("actions/setup-node@")
        ]
        correct_runtime = False
        for step in setup_steps:
            inputs = step.get("with", {})
            if not isinstance(inputs, dict):
                continue
            version_file = inputs.get("node-version-file", "")
            version = inputs.get("node-version", "")
            if version_file == ".nvmrc" or (
                isinstance(version, str) and re.match(r"^v?22(?:\D|$)", version)
            ):
                correct_runtime = True

        if (
            any(use.startswith("actions/checkout@") for use in uses)
            and correct_runtime
            and all(
                has_command(scripts, command)
                for command in ("npm ci", "npm test", "npm run lint")
            )
        ):
            matching_job = True

if not matching_job:
    print(
        "No hosted Linux job runs on pushes and pull requests, checks out the repository, "
        "sets up Node.js 22, and runs npm ci, npm test, and npm run lint.",
        file=sys.stderr,
    )
    raise SystemExit(1)
PY
then
  record_failure "the GitHub Actions workflow does not satisfy the lab behavior"
fi

if ((failures > 0)); then
  printf '\nLab check failed with %d problem(s).\n' "$failures" >&2
  exit 1
fi

printf '\nAll Lab 1 checks passed.\n'
